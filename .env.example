# Copy to .env.local (local) or add in Vercel → Project → Settings → Environment Variables.
# Every section works without keys (demo data) and goes live as soon as its keys are set.

# --- Required in production -------------------------------------------------
DASHBOARD_PASSWORD=

# --- Group resources by business -------------------------------------------
# name-fragment=Business, matched against repo / project / database names
BUSINESS_MAP=kaj=Kaj Consulting,shop=Kaj Store,booking=Kaj Bookings

# --- GitHub: repos, PRs, issues, notifications ------------------------------
# Fine-grained token: Metadata, Contents, Issues, Pull requests (read); plus Notifications for classic tokens
GITHUB_TOKEN=

# --- Vercel: projects + deploy status ---------------------------------------
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# --- Cloudflare: Workers + D1 -----------------------------------------------
# Token permissions: Workers Scripts:Read, D1:Read
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Supabase: projects, health, security/performance advisors, user counts --
# Personal access token from supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# --- Gmail: unified, triaged inbox ------------------------------------------
# OAuth client (Web app) with the gmail.readonly scope; one refresh token per mailbox
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_ACCOUNTS=Kaj Consulting:<refresh-token>,Kaj Store:<refresh-token>

# --- Websites: uptime + sign-ups --------------------------------------------
# domain|Business|optional-supabase-project-ref ; separated by semicolons
WEBSITES=kajconsulting.com|Kaj Consulting|abcdefghijklmnop;shop.example|Kaj Store
