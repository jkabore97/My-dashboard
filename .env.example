# Copy to .env.local (local) or add in Vercel → Project → Settings → Environment Variables.
# Platforms can also be connected from the Platforms page (stored encrypted in
# the database), so most API keys below are optional fallbacks.

# ─── Required in production ─────────────────────────────────────────────────
# Postgres connection string. On Supabase use the *transaction pooler* URL
# (port 6543). Tables are created automatically on first start.
# Leave empty locally to use an embedded database in .data/.
DATABASE_URL=
# 32+ random characters: openssl rand -base64 48
SESSION_SECRET=
# 32 random bytes, base64: openssl rand -base64 32   (encrypts stored tokens; don't lose it)
ENCRYPTION_KEY=
# Public URL of the dashboard, used for OAuth redirects and webhook URLs
APP_URL=https://dashboard.example.com
# Vercel Cron sends this as a Bearer token: openssl rand -hex 32
CRON_SECRET=

# ─── Sign-in (at least one) ─────────────────────────────────────────────────
# Password sign-in
DASHBOARD_PASSWORD=
# Optional: makes password sign-in the same identity (and 2FA) as this Google account
OWNER_EMAIL=
# Google sign-in: only these addresses may sign in (comma-separated)
ALLOWED_EMAILS=
# Two-factor authentication is mandatory unless set to false
REQUIRE_2FA=true
# Self-hosting only: set to true when a reverse proxy (nginx, Caddy…) in front
# of the app overwrites X-Real-IP / appends X-Forwarded-For. Then sign-in
# attempts are limited per IP. Otherwise the client IP can't be trusted and all
# attempts share one looser limit. Not needed on Vercel.
TRUSTED_PROXY=

# ─── Google OAuth client (sign-in + "Connect Gmail") ────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URIs:
#   $APP_URL/api/auth/google/callback
#   $APP_URL/api/connect/gmail/callback
# Enable the Gmail API for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── One-click "Connect" buttons (optional) ─────────────────────────────────
# GitHub OAuth App: github.com/settings/developers, callback $APP_URL/api/connect/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Vercel integration: vercel.com/dashboard/integrations/console, redirect $APP_URL/api/connect/vercel/callback
VERCEL_INTEGRATION_SLUG=
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=

# ─── Webhook signing secrets (or set them on the Platforms page) ────────────
GITHUB_WEBHOOK_SECRET=
VERCEL_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
SUPABASE_WEBHOOK_SECRET=

# ─── Money & risk ──────────────────────────────────────────────────────────
# Dates (deadlines, invoices, renewals) are judged in this timezone, e.g. America/New_York, Africa/Ouagadougou
BUSINESS_TIMEZONE=UTC
# Stripe restricted keys, one per business (or add them on the Platforms page)
# Read access: Balance, Charges, Disputes, Invoices, Subscriptions, Customers
STRIPE_SECRET_KEYS=Kaj Consulting:rk_live_…,Kaj Store:rk_live_…
# Domains to watch besides your websites (the Domains page overrides this)
EXTRA_DOMAINS=

# ─── Fallback API keys (used when nothing is connected in the UI) ───────────
GITHUB_TOKEN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
SUPABASE_ACCESS_TOKEN=
# Label:refresh-token pairs
GMAIL_ACCOUNTS=

# ─── Fallback config (the Settings page overrides these) ────────────────────
BUSINESS_MAP=kaj=Kaj Consulting,shop=Kaj Store
WEBSITES=kajconsulting.com|Kaj Consulting|<supabase-project-ref>;shop.example|Kaj Store
